+  static func calls(lessons: String, status: Int = 200, classHours: String = "[]") -> Data {
+    data(
+      """
+      {"results":[{"status":\(status),"data":\(lessons)},{"status":200,"data":\(classHours)}]}
+      """)
+  }
+}
