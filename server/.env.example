# Kopieren nach .env und füllen. Die Datei .env gehört nie ins Repository.

# Schlüssel der App (Frontstage sendet ihn mit): openssl rand -base64 48
APP_KEY=
# Geheimnis für das Sitzungs-Cookie der Verwaltung: openssl rand -base64 48
SESSION_SECRET=
# Argon2-Hash des Verwaltungspassworts (hash_password, siehe README).
# Der Hash besteht aus $-Abschnitten: in EINFACHE Anführungszeichen setzen, sonst ersetzt Compose sie.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$BEISPIEL$BEISPIEL'

# Aufbewahrung der Rückmeldungen in Tagen
RETENTION_DAYS=365
# Öffentliche Adresse des Dienstes
PUBLIC_BASE_URL=https://frontstage.example.com
# Nur hinter HTTP (lokaler Test) auf false setzen
COOKIE_SECURE=true
# TRUSTED_PROXIES (Adressen, denen X-Forwarded-For geglaubt wird) setzt docker-compose.yml passend zum
# eigenen Netz; ein Wert hier würde dort überschrieben. Siehe README, Abschnitt Reverse-Proxy.
# Optional: true sperrt Suchmaschinen (X-Robots-Tag und robots.txt); der Dockhand-Stack setzt es auf true
NOINDEX=false
