    "feedback.consent.body %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Rückmeldung geht an den Rückmeldedienst der Entwickler (%@): Art, Text, Bildschirmfotos und – nur wenn eingeschaltet – Geräteangaben. Sie wird zwölf Monate aufbewahrt und dann gelöscht. Mit der Kennung, die du nach dem Senden siehst, kannst du die Löschung früher verlangen."
          }
        }
      }
